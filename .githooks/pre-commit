#!/bin/sh
# Optional size guard. Install with:
#   git config core.hooksPath .githooks
# Remove with:
#   git config --unset core.hooksPath
# The guard blocks newly staged files >5 MiB unless explicitly allowlisted.
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(dirname "$0")/../scripts/check-large-files.ps1"
