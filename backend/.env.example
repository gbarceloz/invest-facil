# ============================================================================
# Invest Fácil API — variáveis de ambiente (EXEMPLO — sem valores reais)
# Copie para .env (NÃO versionado) e preencha. Nunca commite credenciais.
# ============================================================================

# ---------------------------------------------------------------------------
# Banco de dados (Supabase PostgreSQL)
# Local: jdbc:postgresql://localhost:5432/investfacil
# Supabase: jdbc:postgresql://db.<projeto>.supabase.co:5432/postgres
# ---------------------------------------------------------------------------
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=

# Importante (modelo de segurança V2):
#   - Runtime da aplicação usa um LOGIN membro do papel investfacil_app:
#       CREATE ROLE investfacil_runtime LOGIN PASSWORD '<gerada localmente>' NOINHERIT;
#       GRANT investfacil_app TO investfacil_runtime;
#   - Flyway usa o usuário postgres (owner) ou um LOGIN membro de investfacil_migrate.
SPRING_DATASOURCE_PASSWORD=

# Opcional: separar a conexão do Flyway (DDL) da conexão de runtime (DML).
SPRING_FLYWAY_URL=
SPRING_FLYWAY_USER=
SPRING_FLYWAY_PASSWORD=

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
PORT=8080
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# JWT e cookies
# Gere o segredo localmente (nunca versione):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

# Em produção, mantenha false: os tokens de verificação só saem por e-mail.
EXPOSE_DEV_TOKENS=false

# Chave opcional (Base64 32 bytes) para criptografar o segredo TOTP.
# Sem ela, a chave é derivada do JWT_SECRET.
APP_MFA_KEY=

# ---------------------------------------------------------------------------
# E-mail transacional (Resend). Sem chave, os links são registrados no log.
# ---------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_FROM=Invest Fácil <nao-responda@investfacil.local>
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Supabase Storage (bucket privado de vídeos)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_VIDEO_BUCKET=videos
SUPABASE_SIGNED_URL_SECONDS=3600

# Limite por arquivo. O Free do Supabase aceita 50 MB; no Pro pode aumentar.
VIDEO_MAX_UPLOAD_BYTES=52428800
VIDEO_MAX_FILE_SIZE=55MB
VIDEO_MAX_REQUEST_SIZE=60MB

# Fallback opcional para demonstração local sem Storage (ex.: /videos/demo.mp4)
VIDEO_DEMO_URL=

# ---------------------------------------------------------------------------
# Conta de demonstração (opcional; nunca versione a senha)
# ---------------------------------------------------------------------------
APP_DEMO_ENABLED=false
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME=Marina Lima

# ---------------------------------------------------------------------------
# Proxy/rate limit. Só habilite TRUST_PROXY se a conexão direta vier de um
# proxy listado em TRUSTED_PROXIES (ex.: IP interno do Render).
# ---------------------------------------------------------------------------
TRUST_PROXY=false
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Cotações informativas (Binance + câmbio). Em falha, a API devolve fallback.
# ---------------------------------------------------------------------------
MARKET_ENABLED=true
MARKET_CACHE_SECONDS=30
