# Audiovisual production media (generated / large)
# Keep runtime fonts, small manifests/JSON, SRT and text reports.
video/projects/**/*.mp4
video/projects/**/*.mov
video/projects/**/*.webm
video/projects/**/*.wav
video/projects/**/*.mp3
video/projects/**/*.m4a
video/projects/**/*.aac
video/projects/**/*.flac
video/projects/**/frames-*/
video/projects/**/*-frames/
video/projects/**/_frames/
video/projects/**/reaudit-frames/
video/projects/**/final-audit-frames/
video/projects/**/final24-audit-frames/
