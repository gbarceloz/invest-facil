!video/projects/investfacil-10-creative-variants/V*/render/contact-sheet.png
!video/projects/investfacil-10-creative-variants/V*/render/frame0.png

# Remotion public media: generated narration/music/SFX; preserve fonts/images.
video/public/**/*.mp4
video/public/**/*.mov
video/public/**/*.webm
video/public/**/*.wav
video/public/**/*.mp3
video/public/**/*.m4a
video/public/**/*.aac
video/public/**/*.flac

# Voice audition media; metadata and VOICE_OPTIONS.md stay tracked/preserved.
video/auditions/voice-samples/**/*.wav
video/auditions/voice-samples/**/*.mp3
video/auditions/voice-samples/**/*.m4a

# Secrets - never commit
.env
.env.*
!.env.example
frontend/.env.local
frontend/.env.production.local

# Logs and execution evidence
*.log
logs/
tcp_info.txt

# Internal work directories (never publish)
